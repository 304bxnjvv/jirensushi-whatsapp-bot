{
  "name": "jirensushi-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "node tests/ui-panel.mjs && node tests/ui-real.mjs",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev:cloudflare": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply jiren --local",
    "deploy": "wrangler deploy",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "5.9.3",
    "playwright": "1.63.0",
    "wrangler": "4.131.0"
  }
}
